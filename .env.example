# LLM providers. LangChain Deep Agents supports several providers and models
# Currently: Minimax M2.7 (orchestrator) + M2.5 (subagents) via OpenRouter
OPENROUTER_API_KEY=openrouter_api_key
ANTHROPIC_API_KEY=anthropic_api_key
FIREWORKS_API_KEY=fireworks_api_key

# You.com API Key
# Get one from you.com/platform
YDC_API_KEY=you_com_api_key

# LangSmith (optional)
LANGSMITH_API_KEY=your_langsmith_api_key

# Enable LangSmith traces
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGSMITH_PROJECT="My LangSmith project"
